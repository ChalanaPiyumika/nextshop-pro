{% if cart.item_count == 0 %}<p>Your bag is empty.</p>{% else %}
<div class="drawer__items">{% for item in cart.items %}<div class="line">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag }}{% endif %}
<div style="flex:1"><div>{{ item.product.title }}</div><small>{{ item.variant.title | replace: 'Default Title','' }}</small><div>{{ item.final_line_price | money }}</div>
<input class="qty" style="width:70px" type="number" min="0" value="{{ item.quantity }}" data-line-qty="{{ forloop.index }}"></div></div>{% endfor %}</div>
<div style="display:flex;justify-content:space-between;margin:16px 0"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
<form action="{{ routes.cart_url }}" method="post"><button class="btn" style="width:100%" name="checkout">Checkout</button></form>{% endif %}