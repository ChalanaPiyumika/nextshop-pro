<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}" class="hero" style="min-height:{{ section.settings.height }}vh;align-items:{{ section.settings.v_align }}">
<div class="hero__media">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true }}{% elsif section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.heading }}{% endif %}</div>
<div class="hero__overlay" style="background:{{ section.settings.overlay }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
<div class="hero__content container" style="text-align:{{ section.settings.text_align }}">
{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
<h1>{{ section.settings.heading }}</h1>{% if section.settings.text != blank %}<div class="rte" style="max-width:560px;{% if section.settings.text_align == 'center' %}margin:0 auto{% endif %}">{{ section.settings.text }}</div>{% endif %}
<div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap;justify-content:{% if section.settings.text_align == 'center' %}center{% else %}flex-start{% endif %}">
{% if section.settings.btn1 != blank %}<a class="btn" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1 }}</a>{% endif %}
{% if section.settings.btn2 != blank %}<a class="btn btn--outline" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2 }}</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional)"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 85
    },
    {
      "type": "select",
      "id": "v_align",
      "label": "Vertical position",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Antoinette Atelier"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Timeless pieces, crafted with intention.</p>"
    },
    {
      "type": "text",
      "id": "btn1",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "btn2",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
