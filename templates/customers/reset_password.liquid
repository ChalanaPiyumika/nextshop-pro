<div class="container" style="padding:80px 24px;max-width:520px">{% if customer %}<h1>{{ customer.first_name }}</h1><a href="{{ routes.account_logout_url }}">Log out</a>{% else %}<h1>Account</h1>{% form 'customer_login' %}<input class="qty" type="email" name="customer[email]" placeholder="Email"><input class="qty" type="password" name="customer[password]" placeholder="Password"><button class="btn">Sign in</button>{% endform %}{% endif %}</div>