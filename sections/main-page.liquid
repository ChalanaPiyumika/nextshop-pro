<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width" style="max-width:820px"><p class="eyebrow">{{ shop.name }}</p><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div></div></section>
{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
