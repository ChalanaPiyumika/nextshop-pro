<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width">{% paginate collection.products by section.settings.per_page %}<div class="collection-hero"><p class="eyebrow">Collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div><div class="collection-toolbar"><span>{{ collection.products_count }} works</span>{% if collection.sort_options.size > 0 %}<select aria-label="Sort" onchange="var u=new URL(location.href);u.searchParams.set('sort_by',this.value);location.href=u">{% for o in collection.sort_options %}<option value="{{ o.value }}" {% if o.value == collection.sort_by %}selected{% endif %}>{{ o.name }}</option>{% endfor %}</select>{% endif %}</div><div class="product-grid" style="grid-template-columns:repeat({{ section.settings.columns }},1fr)">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty-state">No works in this collection yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></section>
{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
