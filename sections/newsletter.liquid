<section id="s-{{ section.id }}" class="section section--dark newsletter" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{% form 'customer', class: 'newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p>Thank you for joining us.</p>{% else %}<label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" required><button type="submit">Subscribe</button>{% endif %}{% endform %}</div></section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Notes from the studio"},{"type":"text","id":"heading","label":"Heading","default":"Join the atelier"},{"type":"richtext","id":"text","label":"Text","default":"<p>New works, studio stories and considered inspiration, delivered occasionally.</p>"},{"type":"color","id":"bg","label":"Background","default":"#1c1915"},{"type":"color","id":"fg","label":"Text","default":"#faf7f1"}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
