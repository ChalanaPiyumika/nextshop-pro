<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}" class="newsletter"><div class="container center"><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>
{% form 'customer', id: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter">
{% if form.posted_successfully? %}<p>Thank you for subscribing.</p>{% else %}<input type="email" name="contact[email]" placeholder="Email address" required><button class="btn">Subscribe</button>{% endif %}{% endform %}</div></section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the atelier"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Early access to new pieces.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
