<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width"><div class="collection-hero"><p class="eyebrow">Search</p><h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Find a work{% endif %}</h1><form action="{{ routes.search_url }}" class="newsletter__form" style="max-width:520px;margin:24px auto 0"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the collection" aria-label="Search"><button type="submit">Search</button></form></div><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% if search.performed and search.results_count == 0 %}<p class="empty-state">Nothing matched your search.</p>{% endif %}</div></section>
{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
