<section id="s-{{ section.id }}" class="section statement" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="page-width">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% case block.type %}{% when 'heading' %}<p class="statement__text">{{ block.settings.text }}</p>{% when 'text' %}<div class="rte statement__copy">{{ block.settings.text }}</div>{% when 'button' %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.label }}</a>{% endcase %}</div>{% endfor %}</div></section>
{% schema %}
{"name":"Editorial statement","settings":[{"type":"color","id":"bg","label":"Background","default":"#faf7f1"},{"type":"color","id":"fg","label":"Text","default":"#26221d"}],"blocks":[{"type":"heading","name":"Statement","settings":[{"type":"textarea","id":"text","label":"Statement","default":"Art has the power to make a room feel entirely your own."}]},{"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text","default":"<p>Chosen slowly, lived with daily.</p>"}]},{"type":"button","name":"Link","settings":[{"type":"text","id":"label","label":"Label","default":"About the atelier"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Editorial statement","blocks":[{"type":"heading"},{"type":"text"}]}]}
{% endschema %}
