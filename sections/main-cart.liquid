<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width"><div class="cart-page"><p class="eyebrow">Your selection</p><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-page__row">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}{% endif %}<div><a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.product.has_only_default_variant %}<p class="cart-line__variant">{{ item.variant.title }}</p>{% endunless %}<div class="field" style="max-width:110px;margin-top:10px"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity"></div><a class="cart-line__remove" href="{{ item.url_to_remove }}">Remove</a></div><span class="cart-line__price">{{ item.final_line_price | money }}</span></div>{% endfor %}<div class="cart-page__summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="cart-drawer__note">Shipping and taxes calculated at checkout.</p><button class="btn btn--outline" type="submit" name="update">Update</button> <button class="btn" type="submit" name="checkout">Checkout</button></div></form>{% else %}<div class="empty-state"><p>Your bag is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
