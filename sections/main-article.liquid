<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><article class="page-width" style="max-width:820px"><p class="blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p><h1>{{ article.title }}</h1>{% if article.image %}<div class="blog-card__media" style="aspect-ratio:16/9">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title }}</div>{% endif %}<div class="rte" style="margin-top:32px">{{ article.content }}</div><p style="margin-top:40px"><a class="text-link" href="{{ blog.url }}">Back to {{ blog.title }}</a></p></article></section>
{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
