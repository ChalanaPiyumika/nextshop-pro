<section id="s-{{ section.id }}" class="hero" style="min-height:{{ section.settings.height }}vh">
  <div class="hero__media">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true }}{% elsif section.settings.image %}{{ section.settings.image | image_url: width: 2600 | image_tag: loading: 'eager', widths: '750,1100,1600,2200,2600', sizes: '100vw', alt: section.settings.heading }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}</div>
  <div class="hero__shade" style="opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  <div class="hero__content{% if section.settings.text_align == 'center' %} hero__content--center{% endif %}" style="text-align:{{ section.settings.text_align }}">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<div class="hero__subheading rte">{{ section.settings.text }}</div>{% endif %}
    <div class="hero__actions">{% if section.settings.btn1 != blank %}<a class="btn" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1 }}</a>{% endif %}{% if section.settings.btn2 != blank %}<a class="btn btn--earth" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2 }}</a>{% endif %}</div>
  </div>
</section>
{% schema %}
{"name":"Hero banner","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"video","id":"video","label":"Background video (optional)"},{"type":"range","id":"overlay_opacity","label":"Image shade","min":0,"max":90,"step":5,"unit":"%","default":65},{"type":"range","id":"height","label":"Height","min":60,"max":100,"step":5,"unit":"vh","default":90},{"type":"select","id":"text_align","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"text","id":"eyebrow","label":"Small heading","default":"Art for considered spaces"},{"type":"text","id":"heading","label":"Heading","default":"Objects of quiet beauty"},{"type":"richtext","id":"text","label":"Text","default":"<p>Original works and thoughtful editions, selected to bring warmth and character to your home.</p>"},{"type":"text","id":"btn1","label":"Primary button","default":"Explore the collection"},{"type":"url","id":"btn1_link","label":"Primary link"},{"type":"text","id":"btn2","label":"Secondary button","default":"Our story"},{"type":"url","id":"btn2_link","label":"Secondary link"}],"presets":[{"name":"Hero banner"}]}
{% endschema %}
