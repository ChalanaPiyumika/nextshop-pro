<section id="s-{{ section.id }}" class="section--{{ section.settings.theme }}" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="editorial{% if section.settings.reverse %} editorial--reverse{% endif %}">
  <div class="editorial__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', alt: section.settings.heading }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
  <div class="editorial__body">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.btn != blank %}<a class="text-link" href="{{ section.settings.btn_link }}">{{ section.settings.btn }}</a>{% endif %}</div>
</div></section>
{% schema %}
{"name":"Image with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false},{"type":"select","id":"theme","label":"Spacing theme","options":[{"value":"dark","label":"Dark feature"},{"value":"light","label":"Light feature"}],"default":"dark"},{"type":"text","id":"eyebrow","label":"Small heading","default":"The edit"},{"type":"text","id":"heading","label":"Heading","default":"A study in natural form"},{"type":"richtext","id":"text","label":"Text","default":"<p>A considered selection of works where organic silhouettes, tactile surfaces and quiet colour meet.</p>"},{"type":"text","id":"btn","label":"Link label","default":"Discover the collection"},{"type":"url","id":"btn_link","label":"Link"},{"type":"color","id":"bg","label":"Background","default":"#1c1915"},{"type":"color","id":"fg","label":"Text","default":"#faf7f1"}],"presets":[{"name":"Image with text"}]}
{% endschema %}
