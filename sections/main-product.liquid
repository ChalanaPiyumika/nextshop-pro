<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="container product">
<div class="product__gallery">{% for media in product.media %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% endfor %}</div>
<div><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p data-price style="font-size:20px">{{ product.selected_or_first_available_variant.price | money }}</p>
{% form 'product', product %}{% assign cur = product.selected_or_first_available_variant %}
<select name="id" class="variant-select" data-variant-select {% if product.has_only_default_variant %}hidden{% endif %}>{% for v in product.variants %}<option value="{{ v.id }}" data-price="{{ v.price | money }}" data-available="{{ v.available }}" {% if v == cur %}selected{% endif %}>{{ v.title }}{% unless v.available %} – sold out{% endunless %}</option>{% endfor %}</select>
{% if section.settings.show_qty %}<input class="qty" type="number" name="quantity" value="1" min="1">{% endif %}
<button type="submit" class="btn" style="width:100%" data-add="Add to bag" data-sold="Sold out" {% unless cur.available %}disabled{% endunless %}>{% if cur.available %}Add to bag{% else %}Sold out{% endif %}</button>
{% if section.settings.dynamic_checkout %}<div style="margin-top:12px">{{ form | payment_button }}</div>{% endif %}{% endform %}
<div class="rte" style="margin-top:32px">{{ product.description }}</div></div></div></section>
{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_qty",
      "label": "Show quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dynamic_checkout",
      "label": "Show Buy it now button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
