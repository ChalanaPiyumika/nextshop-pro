<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width"><div class="collection-hero"><p class="eyebrow">Browse</p><h1>Collections</h1></div><div class="collection-tiles">{% for c in collections %}<a href="{{ c.url }}" class="collection-tile">{% if c.image %}{{ c.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<span class="collection-tile__shade"></span><span class="collection-tile__label">{{ c.title }}<span class="collection-tile__count">{{ c.products_count }} works</span></span></a>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
