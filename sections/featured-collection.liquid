<section id="s-{{ section.id }}" class="section" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="page-width">
  {% assign col = section.settings.collection %}<div class="section-header"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2>{{ section.settings.heading }}</h2></div>{% if section.settings.btn != blank %}<a class="text-link" href="{{ col.url | default: routes.all_products_collection_url }}">{{ section.settings.btn }}</a>{% endif %}</div>
  <div class="product-grid">{% if col != blank %}{% for product in col.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for product in collections.all.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div><p class="product-card__vendor">Antoinette Atelier</p><h3 class="product-card__title">Curated artwork</h3><span class="product-card__price">$0.00</span></article>{% endfor %}{% endfor %}{% endif %}</div>
</div></section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Recently added"},{"type":"text","id":"heading","label":"Heading","default":"New arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":4},{"type":"text","id":"btn","label":"Link label","default":"Shop all works"},{"type":"color","id":"bg","label":"Background","default":"#faf7f1"},{"type":"color","id":"fg","label":"Text","default":"#26221d"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
