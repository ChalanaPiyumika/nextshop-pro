<footer class="site-footer" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="page-width"><div class="site-footer__grid"><div><p class="site-footer__logo">{{ shop.name }}</p><div class="site-footer__tagline rte">{{ section.settings.about }}</div></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2 class="site-footer__heading">{{ block.settings.title }}</h2><ul class="site-footer__menu">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endfor %}<div><h2 class="site-footer__heading">Visit the studio</h2><div class="site-footer__tagline rte">{{ section.settings.studio }}</div></div></div><div class="site-footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</span><span>{{ section.settings.credit }}</span></div></div></footer>
{% schema %}
{"name":"Footer","max_blocks":3,"settings":[{"type":"richtext","id":"about","label":"About text","default":"<p>Original art and objects for thoughtful interiors.</p>"},{"type":"richtext","id":"studio","label":"Studio details","default":"<p>By appointment<br>Monday–Friday</p>"},{"type":"text","id":"copyright","label":"Copyright text","default":"All rights reserved."},{"type":"text","id":"credit","label":"Bottom right text","default":"Made with intention"},{"type":"color","id":"bg","label":"Background","default":"#1c1915"},{"type":"color","id":"fg","label":"Text","default":"#faf7f1"}],"blocks":[{"type":"menu","name":"Menu column","settings":[{"type":"text","id":"title","label":"Title","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}]}
{% endschema %}
