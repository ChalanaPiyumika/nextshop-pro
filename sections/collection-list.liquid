<section id="s-{{ section.id }}" class="section" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }}"><div class="page-width">
  <div class="section-header"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2>{{ section.settings.heading }}</h2></div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label }}</a>{% endif %}</div>
  <div class="collection-tiles">{% for block in section.blocks %}{% assign c = block.settings.collection %}<a href="{{ c.url | default: routes.collections_url }}" class="collection-tile" {{ block.shopify_attributes }}>
    {% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '450,700,1000,1200', sizes: '(min-width: 751px) 33vw, 100vw', alt: block.settings.title }}{% elsif c.image %}{{ c.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}<span class="collection-tile__shade"></span>
    <span class="collection-tile__label"><h3>{{ block.settings.title | default: c.title | default: 'Collection' }}</h3>{% if c != blank %}<span class="collection-tile__count">{{ c.products_count }} pieces</span>{% endif %}</span>
  </a>{% endfor %}</div>
</div></section>
{% schema %}
{"name":"Collection tiles","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Browse"},{"type":"text","id":"heading","label":"Heading","default":"Find your piece"},{"type":"text","id":"link_label","label":"Link label","default":"View all collections"},{"type":"color","id":"bg","label":"Background","default":"#faf7f1"},{"type":"color","id":"fg","label":"Text","default":"#26221d"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"title","label":"Custom title"}]}],"presets":[{"name":"Collection tiles","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}
{% endschema %}
