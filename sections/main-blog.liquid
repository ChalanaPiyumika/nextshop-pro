<style>#s-{{ section.id }}{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.fg != blank %}color:{{ section.settings.fg }};{% endif %}}</style>
<section id="s-{{ section.id }}"><div class="page-width"><div class="collection-hero"><p class="eyebrow">Journal</p><h1>{{ blog.title }}</h1></div>{% paginate blog.articles by 9 %}<div class="blog-grid">{% for article in blog.articles %}<a href="{{ article.url }}" class="blog-card"><div class="blog-card__media">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div><p class="blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p><h2 class="blog-card__title">{{ article.title }}</h2><p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></a>{% else %}<p class="empty-state">No stories yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text color"
    }
  ]
}
{% endschema %}
