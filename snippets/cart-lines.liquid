{% if cart.item_count == 0 %}<div class="cart-drawer__empty"><h3>Your bag is empty</h3><p>Discover original artworks and prints in the collection.</p></div>{% else %}{% for item in cart.items %}<div class="cart-line" data-line-key="{{ item.key }}">{% if item.image %}{{ item.image | image_url: width: 152 | image_tag: class: 'cart-line__image', alt: item.product.title }}{% endif %}<div><p class="cart-line__title">{{ item.product.title }}</p>{% unless item.variant.title == 'Default Title' %}<p class="cart-line__variant">{{ item.variant.title }}</p>{% endunless %}<div class="cart-line__qty"><button type="button" data-qty-change="-1" aria-label="Decrease">−</button><span>{{ item.quantity }}</span><button type="button" data-qty-change="1" aria-label="Increase">+</button></div><button type="button" class="cart-line__remove" data-remove>Remove</button></div><div class="cart-line__price">{{ item.final_line_price | money }}</div></div>{% endfor %}{% endif %}
