<article class="product-card">
  <a href="{{ product.url }}" aria-label="{{ product.title | escape }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,520,760,1000', sizes: '(min-width: 991px) 25vw, 50vw', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% unless product.available %}<span class="product-card__badge">Sold</span>{% endunless %}</div></a>
  {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
  <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <div class="product-card__price">{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}{% if product.price_varies %}From {% endif %}{{ product.price | money }}</div>
  {% if product.available %}<button class="product-card__quick-add" type="button" data-quick-add="{{ product.selected_or_first_available_variant.id }}" aria-label="Add {{ product.title | escape }} to bag" title="Add to bag">+</button>{% endif %}
</article>
